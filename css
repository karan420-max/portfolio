/* General Styles */
body {
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 0;
    background: #f4f4f9;
    color: #333;
}

.resume {
    max-width: 800px;
    margin: 20px auto;
    background: #fff;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

h1, h2, h3 {
    margin: 0 0 10px;
    color: #007bff;
}

ul {
    padding: 0;
    margin: 10px 0;
    list-style: none;
}

ul li {
    margin-bottom: 10px;
}

strong {
    color: #333;
}

a {
    color: #007bff;
    text-decoration: none;
}

/* Header */
.header {
    text-align: center;
    margin-bottom: 20px;
}

.profile-pic {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin-bottom: 10px;
    object-fit: cover;
    background-color: #ddd;
}

.title {
    font-size: 1.2rem;
    font-weight: bold;
    color: #555;
}

.contact-info {
    font-size: 0.9rem;
    color: #777;
}

/* Sections */
section {
    margin-bottom: 20px;
}

.about, .education, .skills, .projects, .activities {
    padding: 10px 0;
    border-bottom: 1px solid #ddd;
}

.about p {
    font-size: 1rem;
    line-height: 1.6;
    color: #555;
}

.education ul, .projects ul, .activities ul {
    padding-left: 20px;
}

.education ul li, .projects ul li, .activities ul li {
    margin-bottom: 10px;
}

.skills-container {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.skill {
    width: 48%;
}

.skill ul {
    padding-left: 20px;
}

/* Footer */
footer {
    text-align: center;
    font-size: 0.9rem;
    color: #555;
    margin-top: 20px;
}
